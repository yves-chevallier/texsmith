{
  "name": "vscode-tmark",
  "displayName": "TMark (TeXSmith Markdown)",
  "description": "Syntax highlighting for TMark, the Markdown dialect of TeXSmith: roles, attributes, references, citations, index entries, counters, containers, data directives and captions.",
  "version": "0.1.0",
  "publisher": "texsmith",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/yves-chevallier/texsmith",
    "directory": "packages/vscode-tmark"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "markdown",
    "tmark",
    "texsmith",
    "latex",
    "typst"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tmark",
        "aliases": [
          "TMark",
          "TeXSmith Markdown"
        ],
        "extensions": [
          ".tmark",
          ".tmd"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tmark",
        "scopeName": "text.html.markdown.tmark",
        "path": "./syntaxes/tmark.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.frontmatter": "yaml",
          "meta.embedded.block.yaml": "yaml",
          "meta.embedded.block.python": "python",
          "meta.embedded.block.latex": "latex",
          "meta.embedded.block.html": "html",
          "meta.embedded.block.typst": "typst",
          "meta.embedded.block.javascript": "javascript",
          "meta.embedded.block.json": "json",
          "meta.embedded.block.shellscript": "shellscript",
          "meta.embedded.block.css": "css",
          "meta.embedded.block.markdown": "markdown",
          "meta.embedded.math.markdown": "latex"
        }
      },
      {
        "scopeName": "text.html.markdown.tmark.injection",
        "path": "./syntaxes/tmark.injection.tmLanguage.json",
        "injectTo": [
          "text.html.markdown",
          "text.html.markdown.tmark"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.yaml": "yaml",
          "meta.embedded.block.python": "python",
          "meta.embedded.block.latex": "latex",
          "meta.embedded.block.html": "html",
          "meta.embedded.block.typst": "typst",
          "meta.embedded.math.markdown": "latex"
        }
      }
    ],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "markup.highlight.tmark",
            "settings": {
              "foreground": "#D4A72C"
            }
          },
          {
            "scope": "markup.smallcaps.tmark",
            "settings": {
              "foreground": "#8A7CC7"
            }
          },
          {
            "scope": [
              "markup.superscript.tmark",
              "markup.subscript.tmark"
            ],
            "settings": {
              "foreground": "#5FA8A8"
            }
          },
          {
            "scope": "markup.underline.insert.tmark",
            "settings": {
              "fontStyle": "underline"
            }
          },
          {
            "scope": "invalid.deprecated.tmark, invalid.deprecated.role.tmark",
            "settings": {
              "fontStyle": "strikethrough"
            }
          }
        ]
      }
    }
  },
  "scripts": {
    "build:grammar": "python3 scripts/build_grammar.py",
    "test": "node --test test/grammar.test.mjs",
    "tokens": "node test/tokens.mjs",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.0.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.0.0"
  }
}
