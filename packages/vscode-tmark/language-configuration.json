{
  "comments": {
    "blockComment": ["<!--", "-->"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "`", "close": "`", "notIn": ["string"] },
    { "open": "$", "close": "$", "notIn": ["string"] },
    { "open": "<!--", "close": "-->", "notIn": ["comment", "string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["`", "`"],
    ["*", "*"],
    ["_", "_"],
    ["=", "="],
    ["~", "~"],
    ["^", "^"],
    ["$", "$"]
  ],
  "folding": {
    "offSide": false,
    "markers": {
      "start": "^\\s*(:{3,}\\s*[A-Za-z]|!!!|\\?\\?\\?\\+?|<!--\\s*#?region\\b)",
      "end": "^\\s*(:{3,}\\s*$|<!--\\s*#?endregion\\b)"
    }
  },
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)"
}
