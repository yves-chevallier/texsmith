\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ts-keystrokes}[2025/11/21 TeXSmith keystroke helpers]

\RequirePackage{tikz}
\usetikzlibrary{shadows}

\newcommand*\keystroke[1]{%
  \tikz[baseline=(key.base)]%
  \node[%
    draw,
    fill=gray!10,
    drop shadow={shadow xshift=0.25ex,shadow yshift=-0.25ex,fill=black!70,opacity=0.75},
    rectangle,
    rounded corners=1.5pt,
    inner ysep=0.1em,
    inner xsep=0.5em,
    line width=0.5pt,
    font=\scriptsize\sffamily
  ](key) {#1\strut};%
}

% Contract macro (fragment-contracts.md §1): \tskeys{Ctrl,Alt,Del} typesets
% each key as a \keystroke box joined by ``+''. The writer already applied
% the key-label table (KEY_LABELS of tmark_ir::registry); the copy below maps
% a raw key name (ctrl, arrow-up) for a writer that did not. A literal comma
% is braced: \tskeys{Ctrl,{,}}.
\BLOCK{ for name, label in ts_key_labels | default([]) }
\expandafter\def\csname ts@key@\VAR{name}\endcsname{\VAR{label}}
\BLOCK{ endfor }
\ExplSyntaxOn
% A key name is looked up as a string: a label the writer already resolved may
% hold anything -- math (\(\leftarrow\)), a space, a symbol -- and such tokens
% cannot go inside \csname. \tl_to_str:n makes the lookup name harmless, the
% table is missed, and the label is typeset exactly as it was written.
\cs_new_protected:Npn \ts_key:n #1
  { \exp_args:Nx \__ts_key_typeset:nn { \tl_to_str:n {#1} } {#1} }
\cs_new_protected:Npn \__ts_key_typeset:nn #1#2
  {
    \cs_if_exist:cTF { ts@key@#1 }
      { \keystroke { \use:c { ts@key@#1 } } }
      { \keystroke { #2 } }
  }
\bool_new:N \l__ts_keys_first_bool
\NewDocumentCommand { \tskeys } { m }
  {
    \group_begin:
    \bool_set_true:N \l__ts_keys_first_bool
    \clist_map_inline:nn { #1 }
      {
        \bool_if:NTF \l__ts_keys_first_bool
          { \bool_set_false:N \l__ts_keys_first_bool }
          { \c_space_tl +~ }
        \ts_key:n { ##1 }
      }
    \group_end:
  }
\ExplSyntaxOff
