\ProvidesPackage{ts-glossary}[2025/11/21 TeXSmith glossary helpers (generated)]

\BLOCK{ set resolved_index_engine = index_engine|default("makeindex")|lower }
\RequirePackage{makeidx}
\RequirePackage[acronym,nopostdot\BLOCK{ if resolved_index_engine in ["texindy", "pyxindy"] },xindy\BLOCK{ endif }]{glossaries}

% Resolve glossary style (supports overriding via press.glossary.style or glossary_style).
\BLOCK{ set default_style = default_glossary_style|default("list") }
\BLOCK{ set raw_style = glossary_style|default("") }
\BLOCK{ set raw_glossary = glossary|default(false) }
\BLOCK{ set acronyms_map = acronyms|default({}) }
\BLOCK{ set acronym_groups_list = acronym_groups|default([]) }
\BLOCK{ set acronym_entry_groups_map = acronym_entry_groups|default({}) }
\BLOCK{ set resolved_style = raw_style if raw_style else (raw_glossary if raw_glossary is string else default_style) }
\BLOCK{ set should_activate = raw_glossary or acronyms_map }

% Custom acronym groups (declared in front-matter ``glossary.groups``).
\BLOCK{ if acronym_groups_list }
\BLOCK{ for group_key, group_title in acronym_groups_list }
\newglossary*{\VAR{group_key}}{\VAR{group_title|latex_escape}}
\BLOCK{ endfor }
\BLOCK{ endif }

\BLOCK{ if should_activate }
\makeglossaries
\setglossarystyle{\VAR{resolved_style}}
\BLOCK{ endif }

% Acronym definitions
\BLOCK{ if acronyms_map }
\BLOCK{ for key, entry in acronyms_map.items() }
\BLOCK{ set pair = entry if (entry is sequence and not entry is string) else [key, entry] }
\BLOCK{ set assigned_group = acronym_entry_groups_map.get(key) }
\BLOCK{ if assigned_group }
\newacronym[type=\VAR{assigned_group}]{\VAR{key}}{\VAR{pair[0]|latex_escape}}{\VAR{pair[1]|latex_escape}}
\BLOCK{ else }
\newacronym{\VAR{key}}{\VAR{pair[0]|latex_escape}}{\VAR{pair[1]|latex_escape}}
\BLOCK{ endif }
\BLOCK{ endfor }
\BLOCK{ endif }

% ---------------------------------------------------------------------------
% Contract macros (fragment-contracts.md §1): \tsgls{key} for a glossary
% term, \tsacr{key} for an acronym (Abbr; the key is the short form
% sanitised to [A-Za-z0-9-], as the writer computes it). An undefined key
% prints as glossaries does (``??'' with a warning), never an error.
%
% \tsacr is \acrshort, never \gls: an acronym typesets its short form
% wherever it stands (decision O5 of specs/migration/parity-triage.md).
% The author never writes the call — the writer substitutes every strict,
% case-sensitive match of a declared key (docs/syntax/abbr.md, tmark spec
% §Glossary and acronyms) — so a first-use expansion would rewrite a
% sentence the author wrote as short, and would say something different
% from the same source on the web, where the key stays inside <abbr>.
% The expansion belongs to the acronym table \printglossary produces.
% \tsgls is a glossary *term* reference (@gls:term), which the author does
% write: there \gls and its first-use expansion are the right default.
\NewDocumentCommand{\tsgls}{m}{\gls{#1}}
\NewDocumentCommand{\tsacr}{m}{\acrshort{#1}}

\endinput
