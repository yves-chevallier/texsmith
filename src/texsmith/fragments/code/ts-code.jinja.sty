% Verbatim options: \PY command characters only for a pygments body.
\newcommand{\ts@code@engineopts}{%
  \ifx\ts@code@engine\ts@code@pygments
    \edef\ts@code@vopts{breaklines,breakanywhere,highlightcolor=gray!20,commandchars=\noexpand\\\noexpand\{\noexpand\}}%
  \else
    \edef\ts@code@vopts{breaklines,breakanywhere,highlightcolor=gray!20}%
  \fi
  \ifx\ts@code@linenums\@empty\else
    \edef\ts@code@vopts{\ts@code@vopts,numbers=left,firstnumber=\ts@code@linenums,stepnumber=1}%
  \fi
  \ifx\ts@code@hllines\@empty\else
    \edef\ts@code@vopts{\ts@code@vopts,highlightlines={\ts@code@hllines}}%
  \fi
  \ifx\ts@code@stretch\@empty\else
    \edef\ts@code@vopts{\ts@code@vopts,baselinestretch=\ts@code@stretch}%
  \fi
}
% The body is captured verbatim into a file at \begin{tscode} (nothing may
% look past the end of that line before fancyvrb scans; a tcolorbox would)
% and typeset from it at \end{tscode} — the classic VerbatimOut pattern. The
% optional argument must follow \begin{tscode} immediately (!O), so a body
% whose first line starts with ``['' is never taken for the key list.
\newcommand{\ts@codebox@begin}[1]{\begin{ts@codebox}[#1]}
\newcommand{\ts@code@input}[1]{\VerbatimInput[#1]{\jobname.tscode}}
% Looking for the optional argument tokenised the end of the \begin line
% (a space token); fancyvrb would then take the body's first line for the
% rest of that line. Eat that space and hand fancyvrb an explicit line end.
\begingroup\lccode`\~=`\^^M\lowercase{\endgroup\def\ts@code@eol{~}}
\def\ts@code@vout#1{\begin{VerbatimOut}{\jobname.tscode}#1}
\def\ts@code@go{\expandafter\ts@code@vout\expandafter{\ts@code@eol}}
\expandafter\def\expandafter\ts@code@eatsp\space{\ts@code@go}
\def\ts@code@cont{%
  \ifx\ts@next\@sptoken
    \expandafter\ts@code@eatsp
  \else
    \expandafter\ts@code@go
  \fi
}
\NewDocumentEnvironment{tscode}{!O{}}{%
  \ts@code@reset
  \pgfkeys{/ts/code/.cd,#1}%
  \ts@code@boxopts
  \ts@code@engineopts
  \VerbatimEnvironment
  \futurelet\ts@next\ts@code@cont
}{%
  \end{VerbatimOut}%
  \expandafter\ts@codebox@begin\expandafter{\ts@code@opts}%
  \expandafter\ts@code@input\expandafter{\ts@code@vopts}%
  \end{ts@codebox}%
}
