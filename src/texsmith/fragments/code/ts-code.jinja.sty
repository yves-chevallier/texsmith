% ---------------------------------------------------------------------------
% Contract environment and macro (fragment-contracts.md §5):
%   \begin{tscode}[lang=py, title={…}, caption={…}, linenums, hl_lines={2-3,7},
%                  id=lst:x, stretch=0.5, class={wide}, engine=pygments]
%   …verbatim body…
%   \end{tscode}
%   \tscodeinline[lang=py]{escaped text}
% The body is verbatim in every engine (a tcolorbox listing for the two
% highlighter packages, fvextra otherwise; engine=pygments marks a body of
% \PY macros). Keys live under /ts/code/; unknown keys are ignored.
% A template restyles the box with \tcbset{/ts/code/.append style={…}} and a
% class with /ts/code/class/<name>/.style={…} (tcolorbox key lists).
\makeatletter
\providecommand{\phantomsection}{}
\pgfkeys{/ts/code/.cd,
  lang/.store in=\ts@code@lang,
  title/.store in=\ts@code@title,
  caption/.store in=\ts@code@caption,
  linenums/.store in=\ts@code@linenums,
  linenums/.default=1,
  hl_lines/.store in=\ts@code@hllines,
  id/.store in=\ts@code@id,
  stretch/.store in=\ts@code@stretch,
  engine/.store in=\ts@code@engine,
  class/.store in=\ts@code@class,
  .unknown/.code={},
}
\pgfkeys{/ts/code/.style={}}
\def\ts@code@text{text}
\def\ts@code@pygments{pygments}
\newcommand{\ts@code@reset}{%
  \def\ts@code@lang{text}\def\ts@code@title{}\def\ts@code@caption{}%
  \def\ts@code@linenums{}\def\ts@code@hllines{}\def\ts@code@id{}%
  \def\ts@code@stretch{}\def\ts@code@engine{}\def\ts@code@class{}%
}
% The box title: the title, else the caption, both when both are given.
\newcommand{\ts@code@settitle}{%
  \ifx\ts@code@title\@empty
    \let\ts@code@boxtitle\ts@code@caption
  \else
    \ifx\ts@code@caption\@empty
      \let\ts@code@boxtitle\ts@code@title
    \else
      \def\ts@code@boxtitle{\ts@code@title{} --- \ts@code@caption}%
    \fi
  \fi
}
% tcolorbox options shared by every engine: title, anchor, restyle hooks.
% (etoolbox's \appto / \eappto, loaded by tcolorbox: an appended part is
% expanded once, never the parts already stored.)
\newcommand{\ts@code@boxopts}{%
  \ts@code@settitle
  \def\ts@code@opts{/ts/code}%
  \ifx\ts@code@id\@empty\else
    \eappto\ts@code@opts{, phantom={\noexpand\phantomsection\noexpand\label{\ts@code@id}}}%
  \fi
  \@for\ts@code@c:=\ts@code@class\do{%
    \pgfkeysifdefined{/ts/code/class/\ts@code@c/.@cmd}{%
      \eappto\ts@code@opts{, /ts/code/class/\ts@code@c}%
    }{}%
  }%
  \ifx\ts@code@boxtitle\@empty\else
    \appto\ts@code@opts{, title={\ts@code@boxtitle}, list entry={\protect\numberline{\thetcbcounter}\ts@code@boxtitle}}%
  \fi
}
\NewDocumentCommand{\tscodeinline}{O{}m}{\texttt{#2}}

