\ProvidesPackage{ts-fonts}[2025/01/10 TeXSmith font selection (generated)]

\RequirePackage{iftex}
% Fallback definition replaced when emoji fonts are available.
\providecommand{\texsmithEmoji}[1]{\textbf{!}}
% Contract macros (fragment-contracts.md §1): \tsscript{slug}{text} switches
% to the fallback font declared for a script (\text<slug>, declared below
% from the scripts pass; transparent when no fallback font exists) and
% \tsemoji{…} typesets an emoji through the emoji font.
\NewDocumentCommand{\tsscript}{mm}{%
  \ifcsname text#1\endcsname
    \csname text#1\endcsname{#2}%
  \else
    #2%
  \fi
}
\NewDocumentCommand{\tsemoji}{m}{\texsmithEmoji{#1}}
\catcode"2135=\active
\protected\def^^^^2135{\ensuremath{\aleph}}
% Map U+200B (zero-width space) to a zero-width breakable skip.
% biblatex's blx-unicode.def appends a literal U+200B inside
% \textnohyphenation (the workaround for biblatex#979 used by babel-french's
% \mkbibnamefamily); rendered through a small-caps font that has no glyph for
% U+200B, this triggers "Missing character" warnings. Activating the codepoint
% here -- before biblatex is loaded -- replaces it with a no-op that preserves
% the breakable zero-width semantics without ever hitting the font.
\catcode"200B=\active
\protected\def^^^^200b{\hskip\z@}

\ifPDFTeX
  \PackageError{ts-fonts}{ts-fonts requires XeLaTeX or LuaLaTeX}{Switch to xelatex or lualatex.}
\else
  \RequirePackage{fontspec}
  \defaultfontfeatures{Ligatures = TeX, Scale = MatchLowercase}

  % fontspec's math setup keeps the legacy OT1 layout alive in a 'legacymaths'
  % symbol font (Computer Modern), where capital Greek sits in slots "00-"0A --
  % that is where a bare $\Omega$ comes from. But it declares those symbols
  % \mathalpha (class 7), and a math alphabet -- \mathrm{k\Omega},
  % \mathbf{\Delta} -- refetches class-7 symbols from the *current* alphabet
  % font: a Unicode text font whose low slots hold control characters, so the
  % glyph silently vanishes ("Missing character ... U+000A"). Redeclare capital
  % Greek as \mathord, always taken from legacymaths: upright in every
  % alphabet, which is what pdfLaTeX prints for \mathrm{k\Omega}. Registered
  % at begin-document so it lands after fontspec's own (hook-deferred) math
  % setup; a no-math fontspec leaves the guard undefined and skips it.
  \makeatletter
  \AtBeginDocument{%
    \@ifundefined{symlegacymaths}{}{%
      \DeclareMathSymbol{\Gamma}{\mathord}{legacymaths}{"00}%
      \DeclareMathSymbol{\Delta}{\mathord}{legacymaths}{"01}%
      \DeclareMathSymbol{\Theta}{\mathord}{legacymaths}{"02}%
      \DeclareMathSymbol{\Lambda}{\mathord}{legacymaths}{"03}%
      \DeclareMathSymbol{\Xi}{\mathord}{legacymaths}{"04}%
      \DeclareMathSymbol{\Pi}{\mathord}{legacymaths}{"05}%
      \DeclareMathSymbol{\Sigma}{\mathord}{legacymaths}{"06}%
      \DeclareMathSymbol{\Upsilon}{\mathord}{legacymaths}{"07}%
      \DeclareMathSymbol{\Phi}{\mathord}{legacymaths}{"08}%
      \DeclareMathSymbol{\Psi}{\mathord}{legacymaths}{"09}%
      \DeclareMathSymbol{\Omega}{\mathord}{legacymaths}{"0A}%
    }%
  }
  \makeatother

  \makeatletter
  \newcommand{\tsDeclareFontSet}[2]{%
    \expandafter\gdef\csname tssetupfonts@#1\endcsname{#2}%
  }
  \newcommand{\tsUseFontSet}[1]{%
    \@ifundefined{tssetupfonts@#1}{%
      \PackageError{ts-fonts}{Unknown font family '#1'}%
        {Use one of: lm, lm-sans, bonum, libertinus, pagella, termes, schola, heros, adventor, cursor, plex, pennstander.}%
    }{%
      \csname tssetupfonts@#1\endcsname
    }%
  }
  \newcommand{\tsSetMonoFallback}{%
    \setmonofont{Latin Modern Mono}%
  }
  \makeatother

  % Latin Modern (lm)
  \tsDeclareFontSet{lm}{%
    \ifLuaTeX
      \setmainfont{Latin Modern Roman}%
      \setsansfont{Latin Modern Sans}%
      \setmonofont{Latin Modern Mono}%
    \else
      \setmainfont{lmroman10}[%
        Extension       = .otf,
        UprightFont     = lmroman10-regular,
        ItalicFont      = lmroman10-italic,
        BoldFont        = lmroman10-bold,
        BoldItalicFont  = lmroman10-bolditalic,
        SmallCapsFont   = lmromancaps10-regular,
        SlantedFont     = lmromanslant10-regular,
        BoldSlantedFont = lmromanslant10-bold,
        Ligatures       = TeX,
      ]%
      \setsansfont{lmsans10}[%
        Extension      = .otf,
        UprightFont    = *-regular,
        ItalicFont     = *-oblique,
        BoldFont       = *-bold,
        BoldItalicFont = *-boldoblique,
      ]%
      \setmonofont{lmmono10}[%
        Extension      = .otf,
        UprightFont    = *-regular,
        ItalicFont     = *-italic,
        BoldFont       = *-regular,
        BoldFeatures   = {FakeBold=2},
        BoldItalicFont = *-italic,
        BoldItalicFeatures = {FakeBold=2},
        SmallCapsFont   = lmmonocaps10-regular,
        SmallCapsFeatures = {Letters=SmallCaps},
      ]%
    \fi
  }

  % Latin Modern Sans Serif (lm-sans)
  \tsDeclareFontSet{lm-sans}{%
    \ifLuaTeX
      \setmainfont{Latin Modern Sans}%
      \setsansfont{Latin Modern Sans}%
      \setmonofont{Latin Modern Mono}%
    \else
      \setmainfont{lmsans10}[%
        Extension      = .otf,
        UprightFont    = *-regular,
        ItalicFont     = *-oblique,
        BoldFont       = *-bold,
        BoldItalicFont = *-boldoblique,
        Ligatures      = TeX,
      ]%
      \setsansfont{lmsans10}[%
        Extension      = .otf,
        UprightFont    = *-regular,
        ItalicFont     = *-oblique,
        BoldFont       = *-bold,
        BoldItalicFont = *-boldoblique,
      ]%
      \setmonofont{IBMPlexMono}[%
        Extension      = .otf,
        UprightFont    = *-Regular,
        ItalicFont     = *-Italic,
        BoldFont       = *-Bold,
        BoldItalicFont = *-BoldItalic,
        Scale=0.90,
        FakeStretch    = 0.92,
      ]%
    \fi
  }

  % Tex Gyre Bonum (bonum)
  \tsDeclareFontSet{bonum}{%
    \RequirePackage{bonum-otf}%
    \tsSetMonoFallback%
  }

  % Libertinus (libertinus)
  \tsDeclareFontSet{libertinus}{%
    \RequirePackage{libertinus}%
    \tsSetMonoFallback%
  }

  % Tex Gyre Pagella (pagella)
  \tsDeclareFontSet{pagella}{%
    \RequirePackage{pagella-otf}%
    \tsSetMonoFallback%
  }

  % Tex Gyre Termes (termes)
  \tsDeclareFontSet{termes}{%
    \RequirePackage{termes-otf}%
    \tsSetMonoFallback%
  }

  % TeX Gyre Schola (schola)
  \tsDeclareFontSet{schola}{%
    \RequirePackage{schola-otf}%
    \tsSetMonoFallback%
  }

  % TeX Gyre Heros (heros)
  \tsDeclareFontSet{heros}{%
    \RequirePackage{heros-otf}%
    \setmainfont{TeX Gyre Heros}%
    \setsansfont{TeX Gyre Heros}%
    \renewcommand{\familydefault}{\sfdefault}%
    \tsSetMonoFallback%
  }

  % TeX Gyre Adventor (adventor)
  \tsDeclareFontSet{adventor}{%
    \RequirePackage{adventor-otf}%
    \setmainfont{TeX Gyre Adventor}%
    \setsansfont{TeX Gyre Adventor}%
    \renewcommand{\familydefault}{\sfdefault}%
    \tsSetMonoFallback%
  }

  % TeX Gyre Cursor (cursor)
  \tsDeclareFontSet{cursor}{%
    \RequirePackage{cursor-otf}%
    \setmainfont{TeX Gyre Cursor}%
    \setsansfont{TeX Gyre Cursor}%
    \renewcommand{\familydefault}{\ttdefault}%
    \tsSetMonoFallback%
  }

  % IBM Plex (plex)
  \tsDeclareFontSet{plex}{%
    \setmainfont{IBMPlexSerif}[%
      Path=./fonts/plex-otf/,%
      UprightFont=*-Regular,%
      ItalicFont=*-Italic,%
      BoldFont=*-Bold,%
      BoldItalicFont=*-BoldItalic,%
    ]%
    \setsansfont{IBMPlexSans}[%
      Path=./fonts/plex-otf/,%
      UprightFont=*-Regular,%
      ItalicFont=*-Italic,%
      BoldFont=*-Bold,%
      BoldItalicFont=*-BoldItalic,%
    ]%
    \setmonofont{IBMPlexMono}[%
      Path=./fonts/plex-otf/,%
      UprightFont=*-Regular,%
      ItalicFont=*-Italic,%
      BoldFont=*-Bold,%
      BoldItalicFont=*-BoldItalic,%
    ]%
  }

  % Penn Stander (pennstander)
  \tsDeclareFontSet{pennstander}{%
    \setmainfont{Latin Modern Roman}%
    \setsansfont{Latin Modern Sans}%
    \setmonofont{Latin Modern Mono}%
  }

  \tsUseFontSet{lm}\fi
